def forward_one_step(model, input_ids, past_key_values):
    t0 = time.time()
    with torch.no_grad():
        outputs = model(
            input_ids=input_ids,
            past_key_values=past_key_values,
            use_cache=True
        )
    logits = outputs.logits[:, -1, :]  # 取最后一个 token 的 logits
    # next_token = torch.argmax(logits, dim=-1).unsqueeze(0)
    next_token = sample_top_k_top_p(logits, top_k=50, top_p=0.9, temperature=1.0)
    print_past_shapes(outputs.past_key_values)
    print("latency:", time.time() - t0)
    return next_token, outputs.past_key_values

def generate(model, tokenizer, prompt, max_new_tokens=10):
    input_ids = tokenizer.encode(prompt, return_tensors="pt")
    past = None

    print("初始输入:", input_ids)
    print("初始文本:", tokenizer.decode(input_ids[0]))

    for step in range(max_new_tokens):
        # 只喂最后一个 token + past
        next_token, past = forward_one_step(model, input_ids[:, -1:], past)

        # 拼接到序列里
        input_ids = torch.cat([input_ids, next_token], dim=-1)

        # 打印每一步的结果
        print(f"\nStep {step+1}:")
        print("生成的 token id:", next_token.tolist())
        print("当前序列:", input_ids.tolist())
        print("当前文本:", tokenizer.decode(input_ids[0]))

    return tokenizer.decode(input_ids[0])

