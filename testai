import torch.nn.functional as F
import time

def sample_top_k_top_p(logits, top_k=50, top_p=0.9, temperature=1.0):
    # temperature
    logits = logits / temperature

    # --- Top-k ---
    if top_k > 0:
        # 只保留 top_k 的 logits，其余设为 -inf
        values, _ = torch.topk(logits, top_k)
        min_values = values[:, -1].unsqueeze(1)
        logits = torch.where(logits < min_values, torch.full_like(logits, -1e10), logits)

    # --- Top-p (nucleus sampling) ---
    if top_p < 1.0:
        sorted_logits, sorted_indices = torch.sort(logits, descending=True)
        probs = F.softmax(sorted_logits, dim=-1)
        cumulative_probs = torch.cumsum(probs, dim=-1)

        # 去掉累计概率超过 top_p 的 token
        sorted_mask = cumulative_probs > top_p
        sorted_mask[:, 1:] = sorted_mask[:, :-1].clone()
        sorted_mask[:, 0] = False

        # 把被 mask 的 logits 设为 -inf
        sorted_logits = torch.where(sorted_mask, torch.full_like(sorted_logits, -1e10), sorted_logits)

        # 把 logits 还原到原来的顺序
        logits = torch.zeros_like(logits).scatter_(1, sorted_indices, sorted_logits)

    # softmax → multinomial 采样
    probs = F.softmax(logits, dim=-1)
    next_token = torch.multinomial(probs, num_samples=1)

    return next_token


